{
  "name": "@mingshen/desktop",
  "version": "1.3.2",
  "private": true,
  "description": "Mingshen Harness desktop application",
  "author": {
    "name": "Ming"
  },
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "node ../../scripts/build-tencent-memory.cjs && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "package:check": "node ../../scripts/check-package.cjs --source",
    "package:win": "node ../../scripts/provision-electron-runtime.cjs && powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/generate-icon.ps1 && node ../../scripts/provision-native-runtime.mjs && pnpm build && pnpm package:check && node ../../scripts/package-windows.cjs"
  },
  "dependencies": {
    "@ast-grep/lang-c": "0.0.6",
    "@ast-grep/lang-cpp": "0.0.6",
    "@ast-grep/lang-csharp": "0.0.6",
    "@ast-grep/lang-go": "0.0.6",
    "@ast-grep/lang-java": "0.0.7",
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/napi": "0.51.1",
    "@napi-rs/canvas": "1.1.0",
    "@tanstack/react-virtual": "3.13.12",
    "@xmldom/xmldom": "0.8.15",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "browserdo-mcp": "0.9.3",
    "cross-spawn": "7.0.6",
    "docx": "9.15.3",
    "dompurify": "^3.4.17",
    "fflate": "0.8.3",
    "katex": "^0.19.1",
    "lucide-react": "1.66.0",
    "mammoth": "1.13.0",
    "marked": "^18.1.2",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "typescript-language-server": "4.3.4",
    "unpdf": "2.1.0",
    "word-extractor": "1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.8.3",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
